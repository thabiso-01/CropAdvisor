{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (local, SQLite, Gemini)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "DATABASE_URL": "sqlite:///./data/crop_advisor.db",
        "UPLOAD_DIR": "./data/uploads"
      },
      "jinja": true,
      "justMyCode": true
    }
  ]
}
