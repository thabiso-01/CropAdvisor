# Copy to .env and add a fresh Gemini API key from Google AI Studio.

# Uploaded crop photos are sent to Google's Gemini API.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT=60
# Used when the main model is overloaded (503/429), times out or is retired. Comma-separated.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# Seconds to wait for the main model before handing over to the fallback.
GEMINI_FIRST_TIMEOUT=25
# Fast model that checks each photo shows a plant before it is analysed.
GEMINI_CHECK_MODEL=gemini-flash-lite-latest

# Requests per hour, per device and per IP address (protects your Gemini quota). 0 = no limit.
ANALYZE_PER_HOUR=30
CHAT_PER_HOUR=120
# Other websites allowed to call the API from a browser (comma-separated). The site itself doesn't need listing.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

POSTGRES_PASSWORD=crop_dev_password

# Optional: use Anthropic Claude instead (AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
