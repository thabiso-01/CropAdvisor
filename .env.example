# Copy to .env and add a fresh Gemini API key from Google AI Studio.

# Cloud AI (faster than CPU-only Ollama). Uploaded crop photos are sent to Google's Gemini API.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT=60
# Used when the main model is overloaded (503/429), times out or is retired. Comma-separated.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# Optional local AI: set AI_PROVIDER=ollama and start Docker with --profile ollama.
# Running the API without Docker? use http://localhost:11434
# Already have the Dietitian AI API's Ollama running? Point this at it to share the models.
OLLAMA_BASE_URL=http://ollama:11434
# Chat model (text). Llama 3.2 ≈ 2 GB.
OLLAMA_MODEL=llama3.2
# Photo model (Llama 3.2 can't see images). qwen3-vl:2b is the lower-memory default;
# use qwen3-vl:4b or qwen3-vl:8b for higher quality on machines with more RAM/VRAM.
# Set to none to analyse photos from notes + leaf colour with Llama 3.2 only.
OLLAMA_VISION_MODEL=qwen3-vl:2b
# Download missing models automatically on startup
OLLAMA_AUTO_PULL=true

POSTGRES_PASSWORD=crop_dev_password

# Optional: use Anthropic Claude instead (AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
